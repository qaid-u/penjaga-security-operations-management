NODE_ENV=development
PORT=3000
PGHOST=localhost
PGPORT=5432
PGDATABASE=penjaga_db
PGUSER=replace_with_database_role
PGPASSWORD=replace_with_database_password
# Alternatively DATABASE_URL; managed PostgreSQL certificates are validated.
# DATABASE_URL=postgresql://user:password@host:5432/database
# PGSSLMODE=require
# PGSSL=true
# PGSSL_CA=certificate_contents_with_literal_backslash_n
JWT_SECRET=replace-with-unique-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=0
# NLP_MODEL_PATH=absolute_path_to_model_json
# Uploads are stored in backend/uploads; there is no UPLOAD_DIR setting.

# Private backend only; never put this key in a VITE_ variable.
GEMINI_API_KEY=
GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite
NLP_AI_REVIEW_ENABLED=false
NLP_REVIEW_TIMEOUT_MS=20000
NLP_REVIEW_MAX_PER_HOUR=60
