NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-frontend-domain.example
TRUST_PROXY=0
# Set TRUST_PROXY=1 only when the API is reachable solely through one trusted reverse proxy.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Prefer DATABASE_URL in production.
DATABASE_URL=postgres://user:password@host:5432/penjaga_db
# Configured TLS verifies certificates. Set PGSSL_CA to a trusted PEM CA if required.
# PGSSLMODE=disable is only for an explicitly approved trusted local/internal connection.
# PGOPTIONS=-c timezone=Asia/Kuala_Lumpur
# PG_BIN=path_to_postgresql_bin_directory_for_backups

# Smoke test account. Use a restricted admin/test account in production.
SMOKE_USERNAME=admin
SMOKE_PASSWORD=replace-with-smoke-test-password
